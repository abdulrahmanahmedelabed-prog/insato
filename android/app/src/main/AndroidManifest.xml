<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ===================== Permissions ===================== -->

    <!-- Microphone capture (record package, runtime permission). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Route capture to a Bluetooth / wired headset microphone when the user
         enables it (record: AudioRecorder manageBluetooth). Normal permission. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Model downloads, Claude API (minutes) and optional Deepgram ASR. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- v1.2 C multi-device meetings: guests connect to the host over the
         LAN (INTERNET covers sockets), the network state tells which
         interface is the Wi-Fi, mDNS discovery (bonsoir / NSD) needs the
         multicast lock, and the QR scanner needs the camera (runtime
         permission; the feature is optional, see uses-feature below). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Keep the CPU awake during long meetings (wakelock_plus,
         flutter_foreground_task). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Foreground service that keeps recording alive while the screen is off
         or another app is in front. Android 14+ (API 34) additionally requires
         the type-specific permission matching foregroundServiceType below. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- v1.2 live call: the call's foreground service also plays the remote
         voice (type mediaPlayback next to microphone). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- v1.2 live call (flutter_webrtc): network changes during a call. -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <!-- Android 13+ (API 33): the ongoing "recording" notification of the
         foreground service is only visible after this runtime permission. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- The app is useless without a microphone; keep it off devices that
         have none (Play Store filtering). -->
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="true" />
    <!-- The camera only scans join codes (typing the code works too). -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!--
        allowBackup=false / dataExtractionRules / fullBackupContent:
        Recordings, transcripts and voiceprints are private and must never be
        copied to cloud backups or to another device. This is also required by
        flutter_secure_storage: keys wrapped by the Android Keystore cannot be
        restored on another device ("Failed to unwrap key").
    -->
    <application
        android:name="${applicationName}"
        android:label="إنصاتو"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false"
        tools:targetApi="31">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!--
            flutter_foreground_task service (declared exactly as the plugin's
            README requires; the class name must not change).
            * foregroundServiceType="microphone": mandatory on Android 14+ for a
              service that captures audio; it must be started while the app is
              in the foreground and after RECORD_AUDIO has been granted.
            * mediaPlayback (v1.2 live call): the call service plays the
              remote voice; the recording service still starts with the
              microphone type only (types passed at start are a subset).
            * stopWithTask="true": the recorder lives in the UI engine, so when
              the user swipes the app away the service stops with it instead of
              leaving an orphaned "recording" notification.
        -->
        <service
            android:name="com.pravera.flutter_foreground_task.service.ForegroundService"
            android:foregroundServiceType="microphone|mediaPlayback"
            android:stopWithTask="true"
            android:exported="false" />

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
