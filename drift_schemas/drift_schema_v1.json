  "fixed_sql": [
    {
      "name": "speakers",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"speakers\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"color\" INTEGER NOT NULL, \"is_named_by_user\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_named_by_user\" IN (0, 1)), \"created_at\" INTEGER NOT NULL, \"centroid\" BLOB NULL, \"embedding_count\" INTEGER NOT NULL DEFAULT 0, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "meetings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"meetings\" (\"id\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"status\" TEXT NOT NULL, \"duration_ms\" INTEGER NOT NULL DEFAULT 0, \"audio_path\" TEXT NULL, \"minutes_json\" TEXT NULL, \"error_message\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "segments",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"segments\" (\"id\" TEXT NOT NULL, \"meeting_id\" TEXT NOT NULL REFERENCES meetings (id) ON DELETE CASCADE, \"idx\" INTEGER NOT NULL, \"start_ms\" INTEGER NOT NULL, \"end_ms\" INTEGER NOT NULL, \"text\" TEXT NOT NULL, \"speaker_id\" TEXT NULL REFERENCES speakers (id) ON DELETE SET NULL, \"language\" TEXT NULL, \"embedding\" BLOB NULL, \"speaker_locked\" INTEGER NOT NULL DEFAULT 0 CHECK (\"speaker_locked\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"settings\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    },
